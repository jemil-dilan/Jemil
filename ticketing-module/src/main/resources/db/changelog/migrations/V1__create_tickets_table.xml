<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="1" author="jemil-team">
        <createTable tableName="tickets">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="booking_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="qr_code" type="varchar(500)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="passenger_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="seat_number" type="varchar(10)"/>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="generated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="timestamp"/>
        </createTable>

        <createIndex indexName="idx_tickets_qr_code" tableName="tickets">
            <column name="qr_code"/>
        </createIndex>
        <createIndex indexName="idx_tickets_booking_id" tableName="tickets">
            <column name="booking_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
