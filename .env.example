# ============================================================
# JEMIL Backend - Environment Variables Template
# Copy this file to .env and adjust values as needed
# ============================================================

# ── Database Credentials ─────────────────────────────────
DB_USER=jemil
DB_PASSWORD=jemil_secret

# ── Database Names ──────────────────────────────────────
AGENCY_DB=agency_db
BOOKING_DB=booking_db
PAYMENT_DB=payment_db
TICKETING_DB=ticketing_db
NOTIFICATION_DB=notification_db

# ── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ── SonarQube Database ──────────────────────────────────
SONAR_DB=sonar
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar

# ── SonarQube ────────────────────────────────────────────
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=sqp_39e24c5682d4ba2c85feea053a691578b7cb5096

# ── Africa's Talking (SMS Service) ──────────────────────
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=

# ── JWT Secret ────────────────────────────────────────────
JWT_SECRET=your-very-long-jwt-secret-key-here-change-in-production
JWT_EXPIRATION=86400000

# ── Payment Gateways ─────────────────────────────────────
MOMO_API_KEY=
MOMO_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
