<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        V1 : Création de la table agencies.
        Règle d'or : ce fichier ne sera JAMAIS modifié après déploiement en prod.
        Si tu veux changer quelque chose → crée V3, V4, etc.
    -->
    <changeSet id="V1-create-agencies" author="jemil-dev">

        <createTable tableName="agencies"
                     remarks="Table des agences de transport partenaires JEMIL">

            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(100)"
                    remarks="Nom commercial de l'agence">
                <constraints nullable="false"/>
            </column>

            <column name="city" type="VARCHAR(100)"
                    remarks="Ville principale du siège de l'agence">
                <constraints nullable="false"/>
            </column>

            <column name="contact_phone" type="VARCHAR(20)"
                    remarks="Numéro de contact principal"/>

            <column name="status" type="VARCHAR(20)"
                    remarks="Statut : ACTIVE, SUSPENDED, INACTIVE"
                    defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <!-- Index pour les recherches fréquentes -->
        <createIndex indexName="idx_agencies_city" tableName="agencies">
            <column name="city"/>
        </createIndex>

        <createIndex indexName="idx_agencies_status" tableName="agencies">
            <column name="status"/>
        </createIndex>

        <!-- Contrainte sur le statut -->
        <sql>
            ALTER TABLE agencies
            ADD CONSTRAINT chk_agency_status
            CHECK (status IN ('ACTIVE', 'SUSPENDED', 'INACTIVE'));
        </sql>

    </changeSet>

</databaseChangeLog>
