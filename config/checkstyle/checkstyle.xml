<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Configuration Checkstyle pour JEMIL.
  Règles adaptées à une architecture DDD / Hexagonale.
  Plus permissif que Google Style sur certains points pour rester productif.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Exclure le code généré -->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value=".*[\\/]generated[\\/].*$"/>
    </module>

    <!-- Fichiers se terminent par une ligne vide -->
    <module name="NewlineAtEndOfFile"/>

    <!-- Pas de tabulations (utiliser des espaces) -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <module name="TreeWalker">

        <!-- ── Imports ──────────────────────────────────────── -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="IllegalImport">
            <!-- Forcer jakarta.* au lieu de javax.* (Spring Boot 3+) -->
            <property name="illegalPkgs" value="javax.persistence, javax.validation"/>
        </module>

        <!-- ── Nommage ───────────────────────────────────────── -->
        <module name="TypeName"/>           <!-- Classes en PascalCase -->
        <module name="MethodName"/>         <!-- Méthodes en camelCase -->
        <module name="ParameterName"/>      <!-- Paramètres en camelCase -->
        <module name="LocalVariableName"/>  <!-- Variables locales en camelCase -->
        <module name="ConstantName"/>       <!-- Constantes en UPPER_SNAKE_CASE -->

        <!-- ── Structure du code ─────────────────────────────── -->
        <module name="OneTopLevelClass"/>       <!-- Une classe par fichier -->
        <module name="InnerTypeLast"/>          <!-- Classes internes à la fin -->
        <module name="EmptyBlock">             <!-- Pas de blocs vides silencieux -->
            <property name="option" value="TEXT"/>
        </module>

        <!-- ── Bonnes pratiques ──────────────────────────────── -->
        <module name="EqualsHashCode"/>          <!-- equals() et hashCode() ensemble -->
        <module name="MissingSwitchDefault"/>    <!-- switch toujours avec default -->
        <module name="DefaultComesLast"/>        <!-- default à la fin du switch -->
        <module name="FallThrough"/>             <!-- pas de fall-through dans switch -->
        <module name="MultipleVariableDeclarations"/> <!-- une variable par ligne -->
        <module name="OneStatementPerLine"/>     <!-- une instruction par ligne -->

        <!-- ── Modificateurs ────────────────────────────────── -->
        <module name="ModifierOrder"/> <!-- ordre: public static final... -->

        <!-- ── Annotations DDD / Spring ─────────────────────── -->
        <!-- Vérifie que @Override est présent quand nécessaire -->
        <module name="MissingOverride"/>

    </module>
</module>
