<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

	<changeSet id="JEMIL-5" author="jemil-cli">
		<createTable tableName="t_city">
			<column name="c_id" type="UUID">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="c_name" type="VARCHAR(100)">
				<constraints nullable="false" />
			</column>
			<column name="c_region" type="VARCHAR(100)" />
		</createTable>

		<createTable tableName="t_agency_branch">
			<column name="c_id" type="UUID">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="c_name" type="VARCHAR(150)">
				<constraints nullable="false" />
			</column>
			<column name="c_address" type="TEXT">
				<constraints nullable="false" />
			</column>
			<column name="c_is_active" type="BOOLEAN"
				defaultValueBoolean="true">
				<constraints nullable="false" />
			</column>
			<column name="c_agency_id" type="UUID">
				<constraints nullable="false"
					foreignKeyName="fk_agency_branch_agency"
					referencedTableName="t_agency" referencedColumnNames="c_id"
					deleteCascade="true" />
			</column>
			<column name="c_city_id" type="UUID">
				<constraints nullable="false"
					foreignKeyName="fk_agency_branch_city" referencedTableName="t_city"
					referencedColumnNames="c_id" />
			</column>
		</createTable>

		<addUniqueConstraint tableName="t_agency_branch"
			columnNames="c_agency_id, c_name"
			constraintName="uq_agency_branch_name" />

		<insert tableName="t_city">
			<column name="c_id"
				value="11111111-1111-1111-1111-111111111111" />
			<column name="c_name" value="Douala" />
		</insert>
		<insert tableName="t_city">
			<column name="c_id"
				value="22222222-2222-2222-2222-222222222222" />
			<column name="c_name" value="Yaoundé" />
		</insert>
		<insert tableName="t_city">
			<column name="c_id"
				value="33333333-3333-3333-3333-333333333333" />
			<column name="c_name" value="Bafoussam" />
		</insert>
		<insert tableName="t_city">
			<column name="c_id"
				value="44444444-4444-4444-4444-444444444444" />
			<column name="c_name" value="Dschang" />
		</insert>

		<rollback>
			<dropTable tableName="t_agency_branch" />
			<dropTable tableName="t_city" />
		</rollback>
	</changeSet>

</databaseChangeLog>
