<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

	<changeSet id="JEMIL-3" author="njoupouandom_nfonka">
		<!-- Outbox Pattern -->
		<createTable tableName="outbox_events">
			<column name="id" type="UUID">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="aggregate_type" type="varchar(100)">
				<constraints nullable="false" />
			</column>
			<column name="aggregate_id" type="varchar(100)">
				<constraints nullable="false" />
			</column>
			<column name="event_type" type="varchar(100)">
				<constraints nullable="false" />
			</column>
			<column name="payload" type="TEXT">
				<constraints nullable="false" />
			</column>
			<column name="created_at" type="TIMESTAMP">
				<constraints nullable="false" />
			</column>
			<column name="status" type="varchar(20)">
				<constraints nullable="false" />
			</column>
			<column name="processed_at" type="TIMESTAMP" />
		</createTable>

		<!-- Agency Domain -->
		<createTable tableName="t_agency">
			<column name="c_id" type="UUID">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="c_name" type="varchar(255)">
				<constraints nullable="false" />
			</column>
			<column name="c_status" type="varchar(20)">
				<constraints nullable="false" />
			</column>
			<column name="c_country_code" type="varchar(10)" />
			<column name="c_phone_number" type="varchar(20)" />
			<column name="c_license_number" type="varchar(100)" />
			<column name="c_created_at" type="timestamp" />
		</createTable>

		<createTable tableName="t_city">
			<column name="c_id" type="UUID">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="c_name" type="VARCHAR(100)">
				<constraints nullable="false" />
			</column>
			<column name="c_region" type="VARCHAR(100)" />
			<column name="c_created_at" type="TIMESTAMP" />
		</createTable>

		<createTable tableName="t_routes">
			<column name="c_id" type="UUID">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="c_agency_id" type="UUID">
				<constraints nullable="false"
					foreignKeyName="fk_routes_agency" referencedTableName="t_agency"
					referencedColumnNames="c_id" />
			</column>
			<column name="c_departure" type="UUID">
				<constraints nullable="false"
					foreignKeyName="fk_routes_departure" referencedTableName="t_city"
					referencedColumnNames="c_id" />
			</column>
			<column name="c_arrival" type="UUID">
				<constraints nullable="false"
					foreignKeyName="fk_routes_arrival" referencedTableName="t_city"
					referencedColumnNames="c_id" />
			</column>
			<column name="c_price" type="DOUBLE PRECISION">
				<constraints nullable="false" />
			</column>
			<column name="c_total_seats" type="INT"
				defaultValueNumeric="0">
				<constraints nullable="false" />
			</column>
		</createTable>

		<createTable tableName="schedules">
			<column name="c_id" type="UUID">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="route_id" type="UUID">
				<constraints nullable="false"
					foreignKeyName="fk_schedules_route" referencedTableName="t_routes"
					referencedColumnNames="c_id" />
			</column>
			<column name="c_departure_time" type="TIMESTAMP">
				<constraints nullable="false" />
			</column>
			<column name="c_total_seats" type="INT">
				<constraints nullable="false" />
			</column>
			<column name="c_available_seats" type="INT">
				<constraints nullable="false" />
			</column>
			<column name="version" type="BIGINT" defaultValueNumeric="0">
				<constraints nullable="false" />
			</column>
		</createTable>

	</changeSet>

</databaseChangeLog>
