     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

	<changeSet id="JEMIL-7-drop-demo-tables" author="codex">
		<preConditions onFail="MARK_RAN">
			<tableExists tableName="t_auth_demo" />
		</preConditions>
		<comment>Drop scaffold demo tables and indexes after Demo purge</comment>
		<dropIndex indexName="idx_auth_demo_name"
			tableName="t_auth_demo" />
		<dropTable tableName="t_auth_demo" />
	</changeSet>

